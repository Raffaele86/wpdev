[Unit]
Description=wpdev · Caddy dedicato (vhost *.localhost, admin 127.0.0.1:2020)

[Service]
ExecStart=%h/.local/bin/caddy run --config %h/.wpdev/caddy/Caddyfile --adapter caddyfile
ExecReload=%h/.local/bin/caddy reload --config %h/.wpdev/caddy/Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
